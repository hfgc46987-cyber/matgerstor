# =============================================================
# StoreCraft — environment configuration
# Copy this file to .env and fill in your Supabase project values.
# =============================================================

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon "public" key (Settings → API → anon public)
# This is the safe, non-secret key meant for the browser.
# NEVER put the service_role key in the frontend.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
